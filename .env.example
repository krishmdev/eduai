# Every setting is optional. Defaults run the full stack locally; EDUAI_BACKEND=bank needs no model.
# auto | mlx (base model, 2-shot) | adapter (LoRA) | ollama | bank
EDUAI_BACKEND=auto
# llama-3b (default) or llama-1b
EDUAI_BASE_MODEL=llama-3b
EDUAI_OLLAMA_URL=http://127.0.0.1:11434
EDUAI_OLLAMA_MODEL=llama3.2:3b
# Run the egress canary at API startup and report it in /api/health
EDUAI_EGRESS_CANARY=0
