#!/bin/sh
# Run a command and all its children with outbound network denied (localhost and unix sockets
# still work), provider keys unset, and Hugging Face in offline mode. macOS only (sandbox-exec).
here="$(cd "$(dirname "$0")" && pwd)"
exec env -u OPENAI_API_KEY -u GEMINI_API_KEY -u ANTHROPIC_API_KEY -u HF_TOKEN \
  HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
  sandbox-exec -f "$here/offline.sb" "$@"
